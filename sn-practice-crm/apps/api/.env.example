# Storage Mode: 'postgres' (required for production) or 'memory' (development default)
CRM_STORAGE=postgres

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWT Verification: Set either SUPABASE_JWKS_URL (asymmetric RS256/ES256/EdDSA) or SUPABASE_JWT_SECRET (symmetric HS256)
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Production CORS Allowed Origins (comma-separated HTTPS origins)
CORS_ALLOWED_ORIGINS=https://crm.example.com

# Server Binding
HOST=127.0.0.1
PORT=8788
