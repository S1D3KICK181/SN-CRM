# Use the self-contained browser demo backend (no Supabase account required).
VITE_USE_LOCAL_DEMO=true
VITE_PRACTICE_API_URL=http://127.0.0.1:8787

# Separate practice server. Demo mode accepts only the local demo session token.
PRACTICE_API_MODE=demo
PRACTICE_API_HOST=127.0.0.1
PRACTICE_API_PORT=8787
PRACTICE_API_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
PRACTICE_API_BODY_LIMIT_BYTES=1048576
PRACTICE_API_DEMO_AS_OF_DATE=2026-10-30
PRACTICE_API_SHUTDOWN_TIMEOUT_MS=10000

# To use Lovable Cloud / Supabase instead, set the flag above to false and add:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# PRACTICE_API_MODE=supabase
#
# Required only for durable write operations and audit receipts. Dashboard reads
# never use this key; they preserve the signed-in user's Supabase RLS context.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
